#!/usr/bin/env python3
"""Install and update TIKZ-FunFig through the supported Codex CLI."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = "0.12.2"
DEFAULT_SOURCE = "git@github.com:iihciyekub/tikz-funfig.git"


class CliError(Exception):
    pass


def codex(*args):
    if not shutil.which("codex"):
        raise CliError("codex CLI is not on PATH; install Codex CLI first")
    # Avoid the checkout's repo-local marketplace shadowing the configured source.
    result = subprocess.run(
        ["codex", *args, "--json"], cwd=Path.home(),
        text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if result.returncode:
        raise CliError(result.stderr.strip() or result.stdout.strip() or "Codex command failed")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise CliError("Codex returned invalid JSON; check your Codex CLI version") from exc


def entries(payload, key):
    value = payload.get(key) if isinstance(payload, dict) else None
    if not isinstance(value, list) or any(not isinstance(item, dict) for item in value):
        raise CliError(f"Unsupported Codex response: expected '{key}' list")
    return value


def identifier(value):
    if not re.fullmatch(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*", value):
        raise CliError(f"Invalid plugin/marketplace identifier: {value!r}")
    return value


def installed_record(marketplace, plugin):
    payload = codex("plugin", "list", "--marketplace", marketplace)
    return next((item for item in entries(payload, "installed")
                 if item.get("pluginId") == f"{plugin}@{marketplace}"
                 and item.get("installed") is True), None)


def installed_root(record, marketplace, plugin):
    if record is None:
        raise CliError(f"{plugin}@{marketplace} is not installed; run 'tff install'")
    version = record.get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.+_-]*", version):
        raise CliError("Codex did not report a usable installed version")
    codex_dir = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))).expanduser()
    root = codex_dir / "plugins" / "cache" / marketplace / plugin / version
    # Do not select the highest cache directory: it can be stale after rollback.
    manifest = root / "plugin.json"
    if not manifest.is_file():
        manifest = root / ".codex-plugin" / "plugin.json"
    if not manifest.is_file():
        raise CliError(f"Installed cache is missing: {root}; run 'tff install'")
    payload = json.loads(manifest.read_text(encoding="utf-8"))
    if payload.get("name") != plugin or payload.get("version") != version:
        raise CliError(f"Installed cache identity/version mismatch: {root}")
    return root


def doctor(root):
    wrapper = root / "skills" / "TIKZ-FunFig" / "scripts" / "funfig.sh"
    if not wrapper.is_file():
        raise CliError(f"Installed dependency doctor is missing: {wrapper}")
    return subprocess.run(["bash", str(wrapper), "doctor"]).returncode


def refresh_helper(root):
    # Only refresh the user's installed helper, never a source-checkout script.
    target = Path(os.environ.get("TFF_BIN_DIR", str(Path.home() / ".local/bin"))).expanduser() / "tff"
    source = root / "scripts" / "tff"
    if Path(__file__).resolve() != target.resolve() or not source.is_file():
        return
    if source.read_bytes() == target.read_bytes():
        return
    fd, temporary = tempfile.mkstemp(prefix=".tff-", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(source.read_bytes())
        os.chmod(temporary, 0o755)
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(f"CLI refreshed: {target}")


def install_or_update(marketplace, plugin, skip_doctor=False):
    markets = entries(codex("plugin", "marketplace", "list"), "marketplaces")
    current = next((item for item in markets if item.get("name") == marketplace), None)
    if current:
        source_type = (current.get("marketplaceSource") or {}).get("sourceType")
        if source_type != "git":
            raise CliError(
                f"Marketplace '{marketplace}' is not Git-backed; existing installation was kept. "
                "See docs/INSTALL_UPDATE.md to switch sources explicitly."
            )
        print(f"Refreshing marketplace: {marketplace}", flush=True)
        # A fetch/network failure must never trigger uninstall/remove fallback.
        codex("plugin", "marketplace", "upgrade", marketplace)
    else:
        source = os.environ.get("TFF_MARKETPLACE_SOURCE", DEFAULT_SOURCE)
        ref = os.environ.get("TFF_MARKETPLACE_REF", "main")
        print(f"Adding marketplace: {marketplace} ({ref})", flush=True)
        codex("plugin", "marketplace", "add", source, "--ref", ref)
        configured = entries(codex("plugin", "marketplace", "list"), "marketplaces")
        if not any(item.get("name") == marketplace for item in configured):
            raise CliError(f"Source did not register marketplace '{marketplace}'; plugin was not installed")
    codex("plugin", "add", f"{plugin}@{marketplace}")
    record = installed_record(marketplace, plugin)
    root = installed_root(record, marketplace, plugin)
    if record.get("enabled") is not True:
        raise CliError("Plugin is installed but disabled by Codex configuration")
    print(f"Installed: {plugin} {record['version']}\nCache: {root}", flush=True)
    refresh_helper(root)
    print("Start a new Codex task to load the updated skills.", flush=True)
    if not skip_doctor and doctor(root):
        print("Plugin installation succeeded; drawing dependencies need attention. Run 'tff doctor'.", file=sys.stderr)
        return 3
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tff", description="Install or update the TIKZ-FunFig Codex plugin.")
    parser.add_argument("--version", "-V", action="version", version=f"tff {VERSION}")
    commands = parser.add_subparsers(dest="command")
    for name, aliases, description in [
        ("install", [], "Install/enable the plugin (also safe to run again)."),
        ("update", ["upgrade"], "Refresh the configured Git source and update the plugin."),
    ]:
        command = commands.add_parser(name, aliases=aliases, help=description)
        command.add_argument("--skip-doctor", action="store_true", help="Install without checking TeX drawing dependencies.")
    commands.add_parser("status", help="Show the actual installed plugin version and source.")
    commands.add_parser("doctor", help="Check the installed plugin's drawing dependencies.")
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    try:
        marketplace = identifier(os.environ.get("TFF_MARKETPLACE", "tikz-funfig"))
        plugin = identifier(os.environ.get("TFF_PLUGIN", "tikz-funfig"))
        if args.command in ("install", "update", "upgrade"):
            return install_or_update(marketplace, plugin, args.skip_doctor)
        record = installed_record(marketplace, plugin)
        if args.command == "status":
            print(f"CLI: {VERSION}\nPlugin: {plugin}@{marketplace}")
            if record is None:
                print("Installed: no\nNext: tff install")
                return 0
            print(f"Installed: {record['version']}\nEnabled: {record.get('enabled')}")
            source = record.get("marketplaceSource") or {}
            print(f"Source: {source.get('source', 'unknown')}")
            print(f"Cache: {installed_root(record, marketplace, plugin)}")
            return 0
        return doctor(installed_root(record, marketplace, plugin))
    except (CliError, OSError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
