  "renderer": "diagram",
  "description": "Basic publication-oriented scientific/mechanism schematic with components, coordinates, annotations, and directional relationships.",
  "required": [
    "diagram"
  ],
  "schema_versions": [
    "1.1"
  ],
  "roles": [
    "component",
    "module",
    "concept",
    "annotation",
    "data"
  ],
  "capabilities": [
    "structured-nodes",
    "manual-layout",
    "relative-layout",
    "component-roles",
    "labelled-edges",
    "groups",
    "measured-layout",
    "layout-constraints",
    "polyline-routing",
    "bounded-layout-repair"
  ],
  "status": "stable",
  "defaults": {
