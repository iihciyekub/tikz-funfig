  "capabilities": ["implicit", "gnuplot", "name-path", "curve-probe", "curve-label", "coordinate-ref"],
  "external_tools": ["latexmk", "gnuplot"],
  "reference_examples": [
    "references/legacy/tikz-memo/iitikz.sty",
    "references/legacy/pgfplots-memo/icommand.tex",
    "references/legacy/pgfplots-memo/隐函数.tex"
  ]
}
