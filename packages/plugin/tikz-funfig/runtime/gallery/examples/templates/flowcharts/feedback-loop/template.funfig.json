{
  "schema_version": "1.1",
  "id": "template-feedback-loop",
  "recipe": "flowchart",
  "kind": "tikz",
  "theme": {
    "id": "journal-monochrome"
  },
  "profile": {
    "id": "journal-single-column"
  },
  "diagram": {
    "layout": {
      "type": "relative"
    },
    "nodes": [
      {
        "id": "collect",
        "label": "Acquire",
        "role": "process",
        "position": {
          "type": "absolute",
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "check",
        "label": "Pass QC?",
        "role": "decision",
        "position": {
          "type": "relative",
          "of": "collect",
          "direction": "right",
          "gap": "28mm"
        }
      },
      {
        "id": "model",
        "label": "Model",
        "role": "process",
        "position": {
          "type": "relative",
          "of": "check",
          "direction": "right",
          "gap": "28mm"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "collect",
        "to": "check",
        "route": "straight",
        "arrows": "forward"
      },
      {
        "id": "e2",
        "from": "check",
        "to": "model",
        "route": "straight",
        "arrows": "forward",
        "label": "yes"
      },
      {
        "id": "e3",
        "from": "check",
        "to": "collect",
        "from_anchor": "south",
        "to_anchor": "south",
        "route": "curve",
        "routing": {
          "bend": 50
        },
        "arrows": "forward",
        "label": "no",
        "label_side": "below"
      }
    ],
    "groups": []
  },
  "outputs": {
    "basename": "feedback-loop",
    "keep_build": false
  },
  "metadata": {
    "template": true,
    "template_id": "feedback-loop"
  }
}
