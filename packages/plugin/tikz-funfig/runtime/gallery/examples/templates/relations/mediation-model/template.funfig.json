{
  "schema_version": "1.1",
  "id": "template-mediation-model",
  "recipe": "relation-diagram",
  "kind": "tikz",
  "theme": {"id": "journal-monochrome"},
  "profile": {"id": "journal-double-column"},
  "diagram": {
    "layout": {"type": "grid", "auto_fit": true},
    "nodes": [
      {"id": "x", "label": "Independent variable", "role": "concept", "position": {"type": "grid", "row": 0, "column": 0}},
      {"id": "m", "label": "Mediator", "role": "concept", "position": {"type": "grid", "row": 0, "column": 1}},
      {"id": "y", "label": "Outcome variable", "role": "concept", "position": {"type": "grid", "row": 0, "column": 2}}
    ],
    "edges": [
      {"id": "h1", "from": "x", "to": "m", "arrows": "forward", "label": "H1"},
      {"id": "h2", "from": "m", "to": "y", "arrows": "forward", "label": "H2"},
      {"id": "direct", "from": "x", "to": "y", "route": "curve", "routing": {"bend": -28}, "arrows": "forward", "label": "Direct effect", "label_side": "below"}
    ],
    "groups": []
  },
  "outputs": {"basename": "mediation-model", "keep_build": false},
  "metadata": {"template": true, "template_id": "mediation-model"}
}
