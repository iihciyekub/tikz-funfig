{
  "schema_version": "1.0",
  "id": "basic-function",
  "recipe": "function-plot",
  "kind": "pgfplots",
  "canvas": {
    "width": "10cm",
    "height": "7cm",
    "border": "2pt"
  },
  "engine": {
    "latex": "auto",
    "compute": "none"
  },
  "axes": {
    "x": {
      "label": "$x$",
      "min": 0,
      "max": 1,
      "ticks": [0, 0.25, 0.5, 0.75, 1]
    },
    "y": {
      "label": "$f(x)$",
      "min": 0,
      "max": 1
    },
    "grid": "major",
    "legend_position": "north west"
  },
  "data_sources": [
    {
      "id": "quadratic",
      "type": "function",
      "expression": "x^2",
      "domain": "0:1",
      "samples": 100
    }
  ],
  "series": [
    {
      "id": "quadratic",
      "source": "quadratic",
      "label": "$f(x)=x^2$",
      "style": {
        "color": "black",
        "line_width": "0.9pt"
      }
    }
  ],
  "regions": [],
  "annotations": [
    {
      "type": "point",
      "at": [0.5, 0.25],
      "label": "$(0.5,0.25)$"
    }
  ],
  "panels": [],
  "outputs": {
    "basename": "figure",
    "keep_build": false
  }
}

