{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wosaide.local/tikz-funfig/figure-design.schema.json",
  "title": "TIKZ-FunFig design and delivery contract",
  "description": "Agent-authored intent and reference interpretation. Does not replace executable FigureSpec or Expert TeX.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task", "family", "render_mode", "intent", "content", "references", "appearance", "delivery"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/identifier"},
    "task": {"enum": ["create", "reproduce", "redesign", "revise", "repair", "migrate"]},
    "family": {"enum": ["plot", "flowchart", "framework", "relation", "schematic", "mixed"]},
    "render_mode": {"enum": ["structured", "expert"]},
    "intent": {"$ref": "#/$defs/text"},
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["must_preserve", "assumptions", "unresolved"],
      "properties": {
        "must_preserve": {"$ref": "#/$defs/texts"},
        "assumptions": {"$ref": "#/$defs/texts"},
        "unresolved": {"$ref": "#/$defs/texts"}
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locator", "roles", "adopt", "do_not_transfer"],
        "properties": {
          "locator": {"$ref": "#/$defs/text"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["content", "structure", "style"]}},
          "adopt": {"$ref": "#/$defs/texts"},
          "do_not_transfer": {"$ref": "#/$defs/texts"}
        }
      }
    },
    "appearance": {
      "type": "object", "additionalProperties": false,
      "required": ["layout", "typography", "theme", "target_width_mm", "minimum_text_pt"],
      "properties": {
        "layout": {"$ref": "#/$defs/text"},
        "typography": {"$ref": "#/$defs/text"},
        "theme": {"$ref": "#/$defs/text"},
        "target_width_mm": {"type": "number", "exclusiveMinimum": 0},
        "minimum_text_pt": {"type": "number", "exclusiveMinimum": 0},
        "profile_id": {"$ref": "#/$defs/text"}
      }
    },
    "knowledge_sources": {"$ref": "#/$defs/texts"},
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["basename", "formats"],
      "properties": {
        "basename": {"$ref": "#/$defs/identifier"},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pdf", "svg"]}, "contains": {"const": "pdf"}}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"render_mode": {"const": "expert"}}},
    "then": {"required": ["knowledge_sources"], "properties": {"knowledge_sources": {"type": "array", "minItems": 1}}}
  }],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  }
}
