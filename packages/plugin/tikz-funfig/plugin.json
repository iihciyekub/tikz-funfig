{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tikz-funfig",
  "version": "0.9.0",
  "description": "Schema-driven publication-quality TikZ and PGFPlots figure generation.",
  "author": {
    "name": "TIKZ-FunFig"
  },
  "keywords": [
    "tikz",
    "pgfplots",
    "latex",
    "scientific-figures",
    "research"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "TIKZ-FunFig",
        "shortDescription": "Build reproducible publication-quality scientific figures",
        "longDescription": "Create, migrate, validate, render, and compile scientific figures from stable FigureSpec recipes using TikZ, PGFPlots, LaTeX, and gnuplot, including managed implicit equations and curve-relative annotations.",
        "developerName": "TIKZ-FunFig",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Create a scientific plot.",
          "Build a flowchart.",
          "Design a research framework.",
          "Create a relation diagram.",
          "Build a scientific schematic.",
          "Convert existing TikZ or PGFPlots."
        ],
        "brandColor": "#000000",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
