# macOS / editor noise
.DS_Store
**/.DS_Store
.vscode/
.idea/
tmp/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# FunFig runtime/build artifacts
**/.funfig/build/
**/.funfig/cache/
**/.funfig/tmp/
**/.funfig/manifest.json
.smoke/
*.manifest.tmp.json
output/

# Generated artifacts inside repository examples. The FigureSpec is the source.
examples/**/figure.tex

# LaTeX / PGFPlots generated files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.ffgeom
*.pgf-plot.gnuplot
*.pgf-plot.table
*.gnuplot
*.table
*_contourtmp*.dat
*_contourtmp*.script

# Rendered/reference binaries are reproducible or source-adjacent assets,
# but are not part of the code repository by default.
*.pdf
*.svg
*.png
*.jpg
*.jpeg
*.webp

# Large/non-development reference binaries and notebook state
*.ttf
*.otf
*.ipynb
.ipynb_checkpoints/

# Workspace/application caches
.mcp-cache/

# IconKitchen is a multi-platform export bundle. Keep only the canonical
# source sizes used to build the Codex Plugin; the plugin assets are tracked
# separately under packages/plugin/tikz-funfig/assets/.
IconKitchen/**
!IconKitchen/
!IconKitchen/macos/
!IconKitchen/macos/AppIcon128.png
!IconKitchen/macos/AppIcon512.png
!IconKitchen/README.md

# Plugin visual assets intentionally override the repository-wide image rule.
!packages/plugin/tikz-funfig/assets/
!packages/plugin/tikz-funfig/assets/*.png
