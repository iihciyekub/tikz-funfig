{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tikz-funfig.local/schemas/source-example.schema.json",
  "title": "TIKZ-FunFig Source Example",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "source_kind",
    "source_version",
    "source_locator",
    "title",
    "figure_families",
    "libraries",
    "commands",
    "engine",
    "code",
    "renderable",
    "compile_eligible",
    "safety_flags",
    "verification",
    "compile_status",
    "license_ids",
    "source_hash",
    "code_hash"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["official", "community", "project"]},
    "source_version": {"type": "string"},
    "source_locator": {
      "type": "object",
      "required": ["path", "line_start", "line_end", "ordinal", "section_path"],
      "properties": {
        "path": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "section_path": {"type": "array"}
      },
      "additionalProperties": false
    },
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "figure_families": {"type": "array", "items": {"type": "string"}},
    "layout_traits": {"type": "array", "items": {"type": "string"}},
    "style_traits": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "libraries": {"type": "array", "items": {"type": "string"}},
    "library_types": {
      "type": "object",
      "properties": {
        "tikz": {"type": "array", "items": {"type": "string"}},
        "pgf": {"type": "array", "items": {"type": "string"}},
        "pgfplots": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "packages": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "keys": {"type": "array", "items": {"type": "string"}},
    "engine": {"enum": ["pdflatex", "xelatex", "lualatex"]},
    "options": {"type": "object"},
    "code": {"type": "string"},
    "setup_code": {"type": "string"},
    "preamble": {"type": "string"},
    "pre": {"type": "string"},
    "post": {"type": "string"},
    "render_instead": {"type": "string"},
    "renderable": {"type": "boolean"},
    "compile_eligible": {"type": "boolean"},
    "safety_flags": {"type": "array", "items": {"type": "string"}},
    "skip_reason": {"type": ["string", "null"]},
    "verification": {"enum": ["source-extracted", "source-compiled", "reviewed"]},
    "compile_status": {"enum": ["not-run", "passed", "failed"]},
    "license_ids": {"type": "array", "items": {"type": "string"}},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
