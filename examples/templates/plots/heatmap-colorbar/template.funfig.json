{
  "schema_version": "1.0",
  "id": "heatmap-golden",
  "recipe": "heatmap",
  "kind": "pgfplots",
  "canvas": {"width": "8cm", "height": "6.5cm", "border": "2pt"},
  "engine": {"latex": "pdflatex", "compute": "none"},
  "axes": {
    "title": "Matrix heatmap",
    "x": {"label": "column", "min": -0.5, "max": 3.5, "ticks": [0, 1, 2, 3]},
    "y": {"label": "row", "min": -0.5, "max": 2.5, "ticks": [0, 1, 2]},
    "grid": "none",
    "colormap": "viridis",
    "colorbar": {"position": "right", "label": "value"}
  },
  "data_sources": [
    {
      "id": "matrix",
      "type": "coordinates",
      "points": [
        [0, 0, 0], [1, 0, 1], [2, 0, 2], [3, 0, 2],
        [0, 1, 3], [1, 1, 4], [2, 1, 5], [3, 1, 6],
        [0, 2, 3.5], [1, 2, -1], [2, 2, 2.99], [3, 2, 3]
      ]
    }
  ],
  "series": [
    {
      "id": "matrix",
      "source": "matrix",
      "plot": {"kind": "heatmap", "mesh_rows": 3, "mesh_cols": 4}
    }
  ],
  "outputs": {"basename": "heatmap", "keep_build": false},
  "metadata": {"golden": true, "reference": "coordinate matrix plot"}
}
