{
  "schema_version": "1.0",
  "id": "generative-cyclic-topology",
  "task": "create",
  "family": "schematic",
  "render_mode": "expert",
  "intent": "Golden cyclic graph for reference topology comparison.",
  "content": {
    "must_preserve": [
      "eight regular ring nodes",
      "complete edge topology"
    ],
    "assumptions": [],
    "unresolved": []
  },
  "references": [],
  "appearance": {
    "layout": "Centered circular graph with one ring of nodes and one small central node",
    "typography": "No text",
    "theme": "journal-monochrome",
    "profile_id": "journal-double-column",
    "target_width_mm": 140,
    "minimum_text_pt": 7.5
  },
  "knowledge_sources": [
    "pgfmanual-3.1.11a-p0149-0149",
    "pgfmanual-3.1.11a-p0160-0161"
  ],
  "routing": {
    "features": [
      "cyclic-symmetry",
      "dense-chords",
      "center-spokes",
      "repeated-components"
    ],
    "recipe_candidate": "scientific-schematic",
    "unsupported_features": [
      "dense-rule-based-graph"
    ],
    "decision": "expert",
    "reason": "The visible complexity is generated by a compact cyclic graph rule; manual schematic nodes and edges would be brittle and visually inconsistent.",
    "expert_patterns": [
      "repeated-components"
    ],
    "knowledge_queries": [
      "polar coordinates cyclic graph",
      "path line drawing"
    ]
  },
  "review": {
    "reference_anchors": [
      "circle center",
      "top node",
      "left/right extrema",
      "bottom node",
      "central node"
    ],
    "repair_limit": 3
  },
  "structure_model": {
    "coordinate_system": "polar",
    "symmetry": {
      "group": "C8",
      "order": 8,
      "phase_deg": 90,
      "tolerance": 0.03
    },
    "generators": [
      {
        "id": "outer",
        "type": "ring_nodes",
        "parameters": {
          "count": 8,
          "radius": 3.0,
          "phase_deg": 90,
          "node_radius": 0.22
        }
      },
      {
        "id": "boundary",
        "type": "boundary_circle",
        "parameters": {
          "nodes": "outer"
        }
      },
      {
        "id": "chords",
        "type": "complete_edges",
        "parameters": {
          "nodes": "outer"
        }
      }
    ],
    "constraints": [
      "eight equally spaced nodes",
      "complete graph"
    ]
  },
  "visual_density": {
    "target": "light",
    "edge_line_width_pt": 0.24,
    "edge_opacity": 0.36,
    "boundary_opacity": 0.58
  },
  "delivery": {
    "basename": "figure",
    "formats": [
      "pdf"
    ]
  }
}
